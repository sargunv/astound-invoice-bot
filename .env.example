# Astound account
ASTOUND_USERNAME=your-username
ASTOUND_PASSWORD=your-password
ASTOUND_HTTP_TIMEOUT_MS=15000
ASTOUND_MAX_PDF_BYTES=10485760

# Durable delivery state
SQLITE_DB_PATH=./db.sqlite
RUN_LOCK_TTL_SECONDS=3600

# SMTP: port 587 uses STARTTLS; for implicit TLS use port 465 and SMTP_SECURE=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=sender@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_TIMEOUT_MS=30000

# Email
EMAIL_FROM="Astound Invoice Bot <sender@example.com>"
EMAIL_TO=receipts@example.com
EMAIL_SUBJECT=Astound invoice found
EMAIL_TEXT=New invoices are available; check the attachments.
EMAIL_MAX_ATTACHMENTS=10
# Estimated base64/MIME bytes per message, not raw PDF bytes.
EMAIL_MAX_BYTES=20971520
